<% layout('/layouts/boilerplate') %>

    <div class="row mt-3">
            <div class="col-8 offset-3">
             <form method="POST" action="/login" class="needs-validation" novalidate>
               <h1>Login</h1>
                <div class="mb-3">
            <label for="username" class="for-label" >username</label>
        <input 
        name="username" 
        id="username" 
        type="text"
        class="form-control"
        required>
       
        </div>
         
          <div class="mb-3">
            <label for="password" class="for-label" >Password</label>
        <input 
        name="password" 
        id="password" 
        type="password"
        class="form-control"
        required>
        <div class="valid-feedback">
            looks good!
        </div>
        </div>
        <button class="btn btn-success">Login</button>
             </form>
            </div>                                                  
    </div>            